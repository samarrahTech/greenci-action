{
  "name": "greenci-action",
  "version": "1.5.3",
  "engines": {
    "node": "24.x"
  },
  "description": "AI-powered E2E test generation and self-healing for CI/CD",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt --transpile-only",
    "test": "jest --coverage",
    "lint": "eslint src/ __tests__/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts'",
    "prepare": "husky"
  },
  "keywords": [
    "github-action",
    "e2e-testing",
    "playwright",
    "ai",
    "test-generation"
  ],
  "author": "GreenCI",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^8.0.1",
    "@anthropic-ai/sdk": "^0.110.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "^5.3.2"
  }
}
